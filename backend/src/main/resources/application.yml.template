spring:
  application:
    name: f1-champions-assessment
  datasource:
    # Database connection settings
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:f1db}
    username: ${DB_USERNAME:f1user}
    # Password should be provided via environment variable or Docker secrets
    driver-class-name: org.postgresql.Driver
    hikari:
      # Connection pool settings - adjust based on your needs
      maximum-pool-size: 10
      minimum-idle: 5
      idle-timeout: 300000
      connection-timeout: 20000
  jpa:
    open-in-view: false
    hibernate:
      # Options: create, create-drop, update, validate, none
      ddl-auto: ${SPRING_JPA_HIBERNATE_DDL_AUTO:create}
    show-sql: ${SPRING_JPA_SHOW_SQL:false}
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect
  jackson:
    serialization:
      write-dates-as-timestamps: false
    time-zone: UTC

server:
  port: ${SERVER_PORT:8080}

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html
    operationsSorter: method

management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: always

logging:
  level:
    root: INFO
    com.f1champions: INFO
    org.hibernate.type.descriptor.sql.BasicBinder: WARN
    org.springframework.core.env: WARN
    org.springframework.boot.context.config: WARN
    org.springframework.boot.diagnostics: INFO
    org.springframework.jdbc.datasource.DriverManagerDataSource: WARN
    com.zaxxer.hikari.HikariConfig: WARN
    com.zaxxer.hikari: WARN

ergast:
  api:
    # Replace with your Ergast API base URL
    base-url: ${ERGAST_API_BASE_URL:https://api.jolpi.ca/ergast/f1}
    endpoints:
      driver-standings: ${ERGAST_API_ENDPOINTS_DRIVER_STANDINGS:/{year}/driverStandings/1.json}
      race-results: ${ERGAST_API_ENDPOINTS_RACE_RESULTS:/{year}/results/1.json}

resilience4j:
  ratelimiter:
    instances:
      ergastApi:
        # Rate limiting settings for Ergast API
        limitForPeriod: 4
        limitRefreshPeriod: 1s
        timeoutDuration: 0s
        registerHealthIndicator: true
        subscribeForEvents: true
        eventConsumerBufferSize: 100
        allowHealthIndicatorToFail: false
      ergastApiHourly:
        limitForPeriod: 500
        limitRefreshPeriod: 1h
        timeoutDuration: 0s
        registerHealthIndicator: true
        subscribeForEvents: true
        eventConsumerBufferSize: 100
        allowHealthIndicatorToFail: false 